{
  "asyncapi": "3.0.0",
  "channels": {
    "ticketPurchased": {
      "address": "ticketing.ticket.purchased",
      "bindings": {
        "amqp": {
          "bindingVersion": "0.3.0",
          "exchange": {
            "autoDelete": false,
            "durable": true,
            "name": "metro.events",
            "type": "topic"
          },
          "is": "routingKey"
        }
      },
      "messages": {
        "TicketPurchasedV1": {
          "$ref": "#/components/messages/TicketPurchasedV1"
        }
      }
    }
  },
  "components": {
    "messages": {
      "TicketPurchasedV1": {
        "contentType": "application/json",
        "correlationId": {
          "location": "$message.payload#/correlationId"
        },
        "description": "Envelope and payload form one JSON message. Deduplicate activity by eventId; do not apply entity-state snapshot ordering. Delivery is designed as at least once.",
        "examples": [
          {
            "name": "SyntheticPurchase",
            "payload": {
              "correlationId": "met-88-contract-example",
              "eventId": "10000000-0000-4000-8000-000000000001",
              "occurredAt": "2026-11-11T12:00:00Z",
              "payload": {
                "currency": "EUR",
                "issuedAt": "2026-11-11T12:00:00Z",
                "passengerId": "40000000-0000-4000-8000-000000000001",
                "priceCents": 250,
                "purchaseId": "20000000-0000-4000-8000-000000000001",
                "ticketId": "30000000-0000-4000-8000-000000000001",
                "ticketTypeId": "50000000-0000-4000-8000-000000000001"
              },
              "producer": "ticketing-service",
              "type": "TicketPurchased",
              "version": 1
            }
          }
        ],
        "name": "TicketPurchased",
        "payload": {
          "schema": {
            "$ref": "./ticket-purchased.v1.schema.json"
          },
          "schemaFormat": "application/schema+json;version=draft-2020-12"
        }
      }
    }
  },
  "defaultContentType": "application/json",
  "info": {
    "description": "TicketPurchased contract based on existing payload/outbox code and adopted AMQP design. Broker topology, relay deployment and notification consumer remain unimplemented/unverified. No broker address or credentials are specified.",
    "title": "MetroIsJustABus ticketing events",
    "version": "1.0.0"
  },
  "operations": {
    "publishTicketPurchased": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/ticketPurchased"
      },
      "messages": [
        {
          "$ref": "#/channels/ticketPurchased/messages/TicketPurchasedV1"
        }
      ],
      "summary": "Publish committed purchase activity through a future outbox relay"
    }
  },
  "x-requirement": "NFR-006",
  "x-status": "Draft for team review; transport and consumers not verified"
}
