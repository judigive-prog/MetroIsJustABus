# Copy to your environment; never commit real values. Secrets are read from *_FILE paths.
SECRET_KEY_FILE=/run/secrets/core_secret_key
DEBUG=false
ALLOWED_HOSTS=["localhost","127.0.0.1","core-backend"]

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=core
POSTGRES_USER=core
POSTGRES_PASSWORD_FILE=/run/secrets/core_db_password

JWT_PRIVATE_KEY_FILE=/run/secrets/core_jwt_private_key.pem
JWT_PUBLIC_KEY_FILE=/run/secrets/core_jwt_public_key.pem
JWT_ISSUER=core-backend
JWT_ACCESS_TTL_SECONDS=3600
