# Copy to your environment; never commit real values. Secrets are read from *_FILE paths.
SECRET_KEY_FILE=/run/secrets/notification_secret_key
DEBUG=false
ALLOWED_HOSTS=["localhost", "127.0.0.1", "notification-service"]

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=notification
POSTGRES_USER=notification
POSTGRES_PASSWORD_FILE=/run/secrets/notification_db_password

# Public key (PEM) of core-backend's token signing key.
JWT_PUBLIC_KEY_FILE=/run/secrets/core_jwt_public_key.pem
JWT_ISSUER=

# Sandboxed SMTP configuration (Mailpit for dev/staging, A-06)
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=notifications@metroisjustabus.pt

# RabbitMQ configuration for event consumption
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD_FILE=/run/secrets/rabbitmq_password
