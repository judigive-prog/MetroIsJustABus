# Copy to your environment; never commit real values. Secrets are read from *_FILE paths.
SECRET_KEY_FILE=/run/secrets/ticketing_secret_key
DEBUG=false
ALLOWED_HOSTS=["localhost"]

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ticketing
POSTGRES_USER=ticketing
POSTGRES_PASSWORD_FILE=/run/secrets/ticketing_db_password

# Public key (PEM) of core-backend's token signing key. JWKS fetching with a cache (N-13) is not implemented yet.
JWT_PUBLIC_KEY_FILE=/run/secrets/core_jwt_public_key.pem
JWT_ISSUER=

PAYMENT_SIM_URL=http://payment-sim:8000
PAYMENT_SIM_TOKEN_FILE=/run/secrets/payment_sim_service_token

PURCHASE_LEASE_SECONDS=30
PURCHASE_RETRY_AFTER_SECONDS=5
