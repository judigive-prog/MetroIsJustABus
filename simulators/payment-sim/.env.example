SECRET_KEY_FILE=/run/secrets/payment_sim_secret_key
DEBUG=false
ALLOWED_HOSTS=["payment-sim","localhost"]

# Persistent store so idempotency survives a restart (proposal in purchase design, OQ-03).
SIM_DB_PATH=/data/payment_sim.sqlite3

# Token that ticketing-service sends. Shared secret until service credentials are decided.
SERVICE_TOKEN_FILE=/run/secrets/payment_sim_service_token

# Delay for the sim_slow token; must exceed ticketing's 3 s read timeout.
SIM_SLOW_SECONDS=4
